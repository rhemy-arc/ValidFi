# Application
# Values: development | production | test | staging (default: development)
NODE_ENV=development
# Port number (default: 3001)
PORT=3001
# API route prefix (default: api/v1)
API_PREFIX=api/v1

# Logging
# Values: fatal | error | warn | info | debug | trace | silent (default: info)
LOG_LEVEL=info
# Enable JSON output for production (default: false)
LOG_JSON=false

# Database (REQUIRED)
# PostgreSQL hostname
DB_HOST=localhost
# PostgreSQL port (default: 5432)
DB_PORT=5432
# PostgreSQL username
DB_USERNAME=postgres
# PostgreSQL password
DB_PASSWORD=postgres
# PostgreSQL database name
DB_DATABASE=securedata

# Redis (REQUIRED)
# Redis hostname
REDIS_HOST=localhost
# Redis port (default: 6379)
REDIS_PORT=6379
# Redis password (optional, leave empty for no auth)
REDIS_PASSWORD=

# Stellar Soroban (REQUIRED)
# Stellar RPC endpoint URL
SOROBAN_NETWORK_URL=https://soroban-testnet.stellar.org
# Stellar network passphrase
SOROBAN_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
# Contract IDs (optional - leave empty if not deployed)
IDENTITY_REGISTRY_CONTRACT_ID=
VERIFICATION_CONTRACT_ID=
ACCESS_CONTROL_CONTRACT_ID=
DATA_SHARING_CONTRACT_ID=

# IPFS / Pinata (optional - IPFS features degrade gracefully without these)
PINATA_API_KEY=
PINATA_API_SECRET=
# IPFS gateway URL (default: https://gateway.pinata.cloud/ipfs/)
PINATA_GATEWAY=https://gateway.pinata.cloud/ipfs/

# Groq AI (optional - AI features disabled without this)
GROQ_API_KEY=

# JWT (REQUIRED)
# JWT signing secret - minimum 32 characters
JWT_SECRET=your-secret-key-change-in-production-min32chars
# JWT token expiration format: <number><unit> where unit is s|m|h|d (default: 7d)
JWT_EXPIRES_IN=7d

# Encryption (REQUIRED)
# Exactly 32-byte encryption key for credential data
ENCRYPTION_KEY=your-32-byte-encryption-key!!!!

# Rate limiting
# Time-to-live in milliseconds (default: 60000)
THROTTLE_TTL=60000
# Max requests per TTL window (default: 60)
THROTTLE_LIMIT=60

# Credential audit logging
# Secret used to HMAC-chain audit entries (optional, falls back to JWT_SECRET if unset)
AUDIT_HMAC_SECRET=your-audit-hmac-secret-change-in-production
# Comma-separated wallet addresses allowed to access the audit query interface (optional)
ADMIN_WALLETS=
# Retention window in days; entries older than this are purged by the worker (default: 365)
AUDIT_RETENTION_DAYS=365
# How often the retention worker sweeps, in hours (default: 24)
AUDIT_RETENTION_SWEEP_HOURS=24
# Set to "false" to disable the background retention worker (default: true)
AUDIT_RETENTION_ENABLED=true

# Backup system
# Enable/disable automatic backups (default: true)
BACKUP_AUTO_ENABLED=true
# Health check interval in hours (default: 6)
BACKUP_HEALTH_CHECK_INTERVAL_HOURS=6
# Enable/disable health monitoring (default: true)
BACKUP_HEALTH_CHECK_ENABLED=true
# Rotation check interval in days (default: 7)
BACKUP_ROTATION_CHECK_INTERVAL_DAYS=7
# Enable/disable rotation (default: true)
BACKUP_ROTATION_ENABLED=true
# Restoration test interval in days (default: 30)
BACKUP_RESTORATION_TEST_INTERVAL_DAYS=30
# Enable/disable restoration tests (default: true)
BACKUP_RESTORATION_TEST_ENABLED=true
